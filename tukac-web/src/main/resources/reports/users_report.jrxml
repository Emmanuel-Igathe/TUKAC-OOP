<?xml version="1.0" encoding="UTF-8"?>
<jasperReport
    xmlns="http://jasperreports.sourceforge.net/jasperreports"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports
                        http://jasperreports.sourceforge.net/xsd/jasperreport.xsd"
    name="users_report"
    pageWidth="595" pageHeight="842"
    columnWidth="555" leftMargin="20" rightMargin="20"
    topMargin="15" bottomMargin="15"
    uuid="aa000001-0000-0000-0000-000000000001">

    <!-- ── Parameters ──────────────────────────────────────────────── -->
    <parameter name="ReportTitle"   class="java.lang.String"/>
    <parameter name="GeneratedBy"   class="java.lang.String"/>
    <parameter name="GeneratedDate" class="java.lang.String"/>
    <parameter name="TotalMembers"  class="java.lang.Long"/>

    <!-- ── Fields (match User entity getters) ──────────────────────── -->
    <field name="name"       class="java.lang.String"/>
    <field name="studentId"  class="java.lang.String"/>
    <field name="email"      class="java.lang.String"/>
    <field name="role"       class="java.lang.String"/>
    <field name="contact"    class="java.lang.String"/>
    <field name="isApproved" class="java.lang.Integer"/>

    <!-- ── Named styles ────────────────────────────────────────────── -->
    <style name="HeaderText"  fontName="DejaVu Sans" fontSize="9" isBold="true" forecolor="#FFFFFF"/>
    <style name="BodyText"    fontName="DejaVu Sans" fontSize="8"/>
    <style name="SmallGray"   fontName="DejaVu Sans" fontSize="8" forecolor="#666666"/>
    <style name="ActiveBadge" fontName="DejaVu Sans" fontSize="8" forecolor="#155724"/>
    <style name="PendBadge"   fontName="DejaVu Sans" fontSize="8" forecolor="#856404"/>

    <background><band splitType="Stretch"/></background>

    <!-- ═══════════════════════════════════════════════════════════════
         TITLE BAND  —  Branded TUKAC header
    ═══════════════════════════════════════════════════════════════════ -->
    <title>
        <band height="115" splitType="Stretch">

            <!-- Dark-blue header background -->
            <rectangle radius="0">
                <reportElement x="0" y="0" width="555" height="72"
                               backcolor="#1E3A5F" forecolor="#1E3A5F" mode="Opaque"
                               uuid="aa000001-0000-0000-0000-000000000010"/>
                <graphicElement><pen lineWidth="0.0"/></graphicElement>
            </rectangle>

            <!-- Gold accent bar at bottom of header -->
            <rectangle radius="0">
                <reportElement x="0" y="69" width="555" height="3"
                               backcolor="#D4A017" forecolor="#D4A017" mode="Opaque"
                               uuid="aa000001-0000-0000-0000-000000000011"/>
                <graphicElement><pen lineWidth="0.0"/></graphicElement>
            </rectangle>

            <!-- Logo placeholder box (white box, left side) -->
            <rectangle radius="4">
                <reportElement x="8" y="8" width="56" height="56"
                               backcolor="#FFFFFF" forecolor="#CCCCCC" mode="Opaque"
                               uuid="aa000001-0000-0000-0000-000000000012"/>
                <graphicElement><pen lineWidth="1.0" lineColor="#CCCCCC"/></graphicElement>
            </rectangle>
            <!-- "T" monogram inside logo box -->
            <staticText>
                <reportElement x="8" y="8" width="56" height="56"
                               forecolor="#1E3A5F" mode="Transparent"
                               uuid="aa000001-0000-0000-0000-000000000013"/>
                <textElement textAlignment="Center" verticalAlignment="Middle">
                    <font size="32" isBold="true" fontName="DejaVu Sans"/>
                </textElement>
                <text><![CDATA[T]]></text>
            </staticText>

            <!-- Club name -->
            <staticText>
                <reportElement x="74" y="10" width="420" height="28"
                               forecolor="#FFFFFF" mode="Transparent"
                               uuid="aa000001-0000-0000-0000-000000000014"/>
                <textElement verticalAlignment="Middle">
                    <font size="22" isBold="true" fontName="DejaVu Sans"/>
                </textElement>
                <text><![CDATA[TUKAC]]></text>
            </staticText>
            <staticText>
                <reportElement x="74" y="38" width="420" height="18"
                               forecolor="#A8C5E8" mode="Transparent"
                               uuid="aa000001-0000-0000-0000-000000000015"/>
                <textElement verticalAlignment="Middle">
                    <font size="9" fontName="DejaVu Sans"/>
                </textElement>
                <text><![CDATA[Technical University of Kenya — Ability Club Portal]]></text>
            </staticText>

            <!-- Top-right label -->
            <staticText>
                <reportElement x="494" y="55" width="60" height="14"
                               forecolor="#D4A017" mode="Transparent"
                               uuid="aa000001-0000-0000-0000-000000000016"/>
                <textElement textAlignment="Right">
                    <font size="7" isBold="true" fontName="DejaVu Sans"/>
                </textElement>
                <text><![CDATA[CONFIDENTIAL]]></text>
            </staticText>

            <!-- Report title below header -->
            <textField>
                <reportElement x="0" y="80" width="555" height="20"
                               forecolor="#1E3A5F" mode="Transparent"
                               uuid="aa000001-0000-0000-0000-000000000017"/>
                <textElement textAlignment="Center" verticalAlignment="Middle">
                    <font size="13" isBold="true" fontName="DejaVu Sans"/>
                </textElement>
                <textFieldExpression><![CDATA[$P{ReportTitle}]]></textFieldExpression>
            </textField>

            <!-- Generated by / date row -->
            <textField isBlankWhenNull="true">
                <reportElement x="0" y="103" width="300" height="11"
                               forecolor="#555555" mode="Transparent"
                               uuid="aa000001-0000-0000-0000-000000000018"/>
                <textElement><font size="8" fontName="DejaVu Sans"/></textElement>
                <textFieldExpression><![CDATA["Generated by: " + $P{GeneratedBy}]]></textFieldExpression>
            </textField>
            <textField isBlankWhenNull="true">
                <reportElement x="255" y="103" width="300" height="11"
                               forecolor="#555555" mode="Transparent"
                               uuid="aa000001-0000-0000-0000-000000000019"/>
                <textElement textAlignment="Right"><font size="8" fontName="DejaVu Sans"/></textElement>
                <textFieldExpression><![CDATA["Date: " + $P{GeneratedDate}]]></textFieldExpression>
            </textField>
        </band>
    </title>

    <!-- ═══════════════════════════════════════════════════════════════
         COLUMN HEADER
    ═══════════════════════════════════════════════════════════════════ -->
    <columnHeader>
        <band height="26" splitType="Stretch">
            <rectangle radius="0">
                <reportElement x="0" y="0" width="555" height="26"
                               backcolor="#2E6DA4" forecolor="#2E6DA4" mode="Opaque"
                               uuid="aa000001-0000-0000-0000-000000000020"/>
                <graphicElement><pen lineWidth="0.0"/></graphicElement>
            </rectangle>
            <staticText>
                <reportElement x="4" y="0" width="140" height="26" mode="Transparent" forecolor="#FFFFFF" uuid="aa000001-0000-0000-0000-000000000021"/>
                <textElement verticalAlignment="Middle"><font isBold="true" size="8" fontName="DejaVu Sans"/></textElement>
                <text><![CDATA[Full Name]]></text>
            </staticText>
            <staticText>
                <reportElement x="144" y="0" width="85" height="26" mode="Transparent" forecolor="#FFFFFF" uuid="aa000001-0000-0000-0000-000000000022"/>
                <textElement verticalAlignment="Middle"><font isBold="true" size="8" fontName="DejaVu Sans"/></textElement>
                <text><![CDATA[Student ID]]></text>
            </staticText>
            <staticText>
                <reportElement x="229" y="0" width="170" height="26" mode="Transparent" forecolor="#FFFFFF" uuid="aa000001-0000-0000-0000-000000000023"/>
                <textElement verticalAlignment="Middle"><font isBold="true" size="8" fontName="DejaVu Sans"/></textElement>
                <text><![CDATA[Email Address]]></text>
            </staticText>
            <staticText>
                <reportElement x="399" y="0" width="95" height="26" mode="Transparent" forecolor="#FFFFFF" uuid="aa000001-0000-0000-0000-000000000024"/>
                <textElement verticalAlignment="Middle"><font isBold="true" size="8" fontName="DejaVu Sans"/></textElement>
                <text><![CDATA[Role]]></text>
            </staticText>
            <staticText>
                <reportElement x="494" y="0" width="60" height="26" mode="Transparent" forecolor="#FFFFFF" uuid="aa000001-0000-0000-0000-000000000025"/>
                <textElement textAlignment="Center" verticalAlignment="Middle"><font isBold="true" size="8" fontName="DejaVu Sans"/></textElement>
                <text><![CDATA[Status]]></text>
            </staticText>
        </band>
    </columnHeader>

    <!-- ═══════════════════════════════════════════════════════════════
         DETAIL — alternating row shading
    ═══════════════════════════════════════════════════════════════════ -->
    <detail>
        <band height="17" splitType="Stretch">
            <!-- Even-row shading -->
            <rectangle radius="0">
                <reportElement x="0" y="0" width="555" height="17"
                               backcolor="#EBF3FB" forecolor="#EBF3FB" mode="Opaque"
                               uuid="aa000001-0000-0000-0000-000000000030">
                    <printWhenExpression><![CDATA[$V{REPORT_COUNT} % 2 == 0]]></printWhenExpression>
                </reportElement>
                <graphicElement><pen lineWidth="0.0"/></graphicElement>
            </rectangle>

            <textField isBlankWhenNull="true">
                <reportElement x="4" y="2" width="140" height="13" uuid="aa000001-0000-0000-0000-000000000031"/>
                <textElement><font size="8" fontName="DejaVu Sans"/></textElement>
                <textFieldExpression><![CDATA[$F{name}]]></textFieldExpression>
            </textField>
            <textField isBlankWhenNull="true">
                <reportElement x="144" y="2" width="85" height="13" uuid="aa000001-0000-0000-0000-000000000032"/>
                <textElement><font size="8" fontName="DejaVu Sans"/></textElement>
                <textFieldExpression><![CDATA[$F{studentId}]]></textFieldExpression>
            </textField>
            <textField isBlankWhenNull="true">
                <reportElement x="229" y="2" width="170" height="13" uuid="aa000001-0000-0000-0000-000000000033"/>
                <textElement><font size="8" fontName="DejaVu Sans"/></textElement>
                <textFieldExpression><![CDATA[$F{email}]]></textFieldExpression>
            </textField>
            <textField isBlankWhenNull="true">
                <reportElement x="399" y="2" width="95" height="13" uuid="aa000001-0000-0000-0000-000000000034"/>
                <textElement><font size="8" fontName="DejaVu Sans"/></textElement>
                <textFieldExpression><![CDATA[$F{role} != null ? $F{role}.toUpperCase() : ""]]></textFieldExpression>
            </textField>
            <!-- Status badge: green for approved, amber for pending -->
            <textField isBlankWhenNull="true">
                <reportElement x="494" y="2" width="60" height="13" forecolor="#155724" mode="Transparent"
                               uuid="aa000001-0000-0000-0000-000000000035">
                    <printWhenExpression><![CDATA[$F{isApproved} != null && $F{isApproved} == 1]]></printWhenExpression>
                </reportElement>
                <textElement textAlignment="Center"><font size="8" isBold="true" fontName="DejaVu Sans"/></textElement>
                <textFieldExpression><![CDATA["Active"]]></textFieldExpression>
            </textField>
            <textField isBlankWhenNull="true">
                <reportElement x="494" y="2" width="60" height="13" forecolor="#856404" mode="Transparent"
                               uuid="aa000001-0000-0000-0000-000000000036">
                    <printWhenExpression><![CDATA[$F{isApproved} == null || $F{isApproved} != 1]]></printWhenExpression>
                </reportElement>
                <textElement textAlignment="Center"><font size="8" isBold="true" fontName="DejaVu Sans"/></textElement>
                <textFieldExpression><![CDATA["Pending"]]></textFieldExpression>
            </textField>
        </band>
    </detail>

    <!-- ═══════════════════════════════════════════════════════════════
         SUMMARY — total count
    ═══════════════════════════════════════════════════════════════════ -->
    <summary>
        <band height="32" splitType="Stretch">
            <line>
                <reportElement x="0" y="4" width="555" height="1" uuid="aa000001-0000-0000-0000-000000000040"/>
                <graphicElement><pen lineWidth="1.0" lineColor="#2E6DA4"/></graphicElement>
            </line>
            <textField>
                <reportElement x="0" y="12" width="555" height="14" forecolor="#1E3A5F"
                               uuid="aa000001-0000-0000-0000-000000000041"/>
                <textElement textAlignment="Right">
                    <font size="9" isBold="true" fontName="DejaVu Sans"/>
                </textElement>
                <textFieldExpression><![CDATA["Total records: " + $V{REPORT_COUNT}]]></textFieldExpression>
            </textField>
        </band>
    </summary>

    <!-- ═══════════════════════════════════════════════════════════════
         PAGE FOOTER
    ═══════════════════════════════════════════════════════════════════ -->
    <pageFooter>
        <band height="22" splitType="Stretch">
            <line>
                <reportElement x="0" y="0" width="555" height="1" uuid="aa000001-0000-0000-0000-000000000050"/>
                <graphicElement><pen lineWidth="0.5" lineColor="#CCCCCC"/></graphicElement>
            </line>
            <staticText>
                <reportElement x="0" y="5" width="280" height="14" forecolor="#999999"
                               uuid="aa000001-0000-0000-0000-000000000051"/>
                <textElement><font size="7" fontName="DejaVu Sans"/></textElement>
                <text><![CDATA[TUKAC Portal — This report is strictly confidential]]></text>
            </staticText>
            <textField>
                <reportElement x="430" y="5" width="125" height="14"
                               uuid="aa000001-0000-0000-0000-000000000052"/>
                <textElement textAlignment="Right"><font size="7" fontName="DejaVu Sans"/></textElement>
                <textFieldExpression><![CDATA["Page " + $V{PAGE_NUMBER}]]></textFieldExpression>
            </textField>
        </band>
    </pageFooter>

</jasperReport>
